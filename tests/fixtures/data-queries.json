          "$scope": {
            "people": {
              "$input": "owners"
            },
            "dealTypes": [
              "renewal"
            ]
          }
        },
        "labelKey": "owner"
      },
      "style": {
        "base": {}
      }
    },
    {
      "id": "t1",
      "type": "table",
      "parent": null,
      "order": "t1",
