      "parent": null,
      "order": "m1",
      "props": {
        "content": {
          "$bind": "member.name"
        }
      },
      "style": {
        "base": {}
      },
      "repeat": {
        "each": {
          "$bind": "team.rows"
        },
        "as": "member"
      }
    },
    {
      "id": "rp",
      "type": "repeater",
      "parent": null,
      "order": "rp",
      "props": {
        "items": {
          "$bind": "leads.rows"
