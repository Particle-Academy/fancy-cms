{
  "about": "Shared PHP/React parity spec for $params, $scope, <stream>#<alias> and {\"$input\"} references: DataRequests::queries() and dataQueries() must return exactly these queries. Byte-identical in fancy-cms and fancy-cms-ui.",
  "nodes": [
    {
      "id": "in1",
      "type": "input",
      "parent": null,
      "order": "in1",
      "props": {
        "name": "period",
        "kind": "daterange",
        "label": "Period",
        "default": {
          "from": "2026-01-01",
          "to": "2026-03-31"
        }
      },
      "style": {
        "base": {}
      }
    },
    {
      "id": "in2",
      "type": "input",
      "parent": null,
      "order": "in2",
      "props": {
        "name": "owners",
        "kind": "multiselect",
        "label": "Owners",
        "options": {
          "$bind": "lists.people"
        },
        "default": []
      },
      "style": {
        "base": {}
      }
    },
    {
      "id": "k1",
      "type": "kpi",
      "parent": null,
      "order": "k1",
      "props": {
        "label": "Revenue",
        "value": {
          "$bind": "metrics.totals.revenue",
          "$params": {
            "groupBy": "owner"
          },
          "$scope": {
            "period": {
              "$input": "period"
